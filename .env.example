# Copy to .env and fill in. .env is gitignored; never commit real values.

# Gemini, which writes course summaries and quizzes (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Sends "Contact us" messages and sign-up codes. Production uses Brevo (Senders & Domains -> SMTP & API):
# SMTP_HOST=smtp-relay.brevo.com, SMTP_USER=<SMTP login, xxxx@smtp-brevo.com>, SMTP_PASSWORD=<SMTP key>.
# Port 587 is blocked on the production network, so use 465 (SSL).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# the address emails come from; with Brevo the SMTP login isn't a real address, so set this
SMTP_FROM=Ilna <no-reply@ilna-academic.com>

# signs login tokens; any long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# changing it logs everyone out
SECRET_KEY=

# the only email that can get an admin login code at /admin
ADMIN_EMAIL=

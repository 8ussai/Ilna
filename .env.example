# Copy to .env and fill in. .env is gitignored; never commit real values.

# Gemini, which writes course summaries and quizzes (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Mailbox that sends "Contact us" messages (e.g. a Gmail account with an app password:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<the address>, SMTP_PASSWORD=<16-character app password>)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# optional, defaults to SMTP_USER
SMTP_FROM=
